# Azure DevOps Configuration (required)
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_ORG=your-org-name
AZURE_DEVOPS_PROJECT=your-project-name

# ADO Git repository name (required)
ADO_REPOSITORY_NAME=continia-banking

# Target repository where DevopsCoder writes branches/PRs (required)
TARGET_REPO_PATH=/repos/continia-banking

# Base directory for per-work-item git worktrees (required)
WORKTREE_BASE=/repos/.worktrees

# Optional: Tag that triggers the implement pipeline (default: agent implement)
# TRIGGER_TAG=agent implement

# Optional: Tag set by the service when revision loop is exhausted (default: agent-blocked)
# BLOCKED_TAG=agent-blocked

# Optional: Tag set by the service when analyzer rejects a work item (default: need-input)
# NEED_INPUT_TAG=need-input

# Optional: Polling interval in minutes (default: 5)
# POLL_INTERVAL_MINUTES=5

# Optional: Max concurrent pipelines (default: 1)
# CONCURRENCY=1

# Optional: Max revision loop iterations before escalating (default: 3)
# MAX_REVISIONS=3

# Optional: Max analyzer reject cycles per WI before need-input lockout (default: 3)
# MAX_REJECT_CYCLES=3

# Optional: Claude model to use (default: claude-opus-4-7)
# CLAUDE_MODEL=claude-opus-4-7

# ---------------------------------------------------------------------------
# Per-step models
#
# Every LLM step falls back to CLAUDE_MODEL. Override a step to move just that
# step onto another model:
#
#   CLAUDE_MODEL_ANALYZER, CLAUDE_MODEL_CODER, CLAUDE_MODEL_FIX_FINDINGS,
#   CLAUDE_MODEL_REVIEWER, CLAUDE_MODEL_TEST_AUTHOR, CLAUDE_MODEL_TEST_FIXER,
#   CLAUDE_MODEL_PR_MESSAGE
#
# CLAUDE_MODEL_FIX_FINDINGS is revision rounds 2+ (fix-findings replaces a
# fresh coder-plan + coder once there is something to fix rather than write) —
# the knob for spending more on fixing than on first-draft writing.
#
# CLAUDE_MODEL_REVIEWER applies to all 6 axes in parallel, so it multiplies by 6.
# CLAUDE_MODEL_PR_MESSAGE is one short read-only call over the branch diff that
# writes the PR title and bullets — a cheap model is usually the right one.
#
# Setting a PLANNING model additionally turns on the plan-then-write split: the
# coder and the test-author each get a read-only plan call (no Edit/Write) on the
# planning model, and the resulting plan is handed to their write call on the
# cheaper model. Leave the planning vars unset to keep the previous behaviour of
# one call per stage.
#
# Recommended shape — think big, type cheap:
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MODEL_PLANNING=claude-opus-5
# CLAUDE_MODEL_ANALYZER=claude-opus-5
# CLAUDE_MODEL_REVIEWER=claude-opus-5
#
# Per-stage planning overrides (default to CLAUDE_MODEL_PLANNING):
# CLAUDE_MODEL_CODER_PLAN=claude-opus-5
# CLAUDE_MODEL_TEST_AUTHOR_PLAN=claude-sonnet-5
#
# Turn budget for a plan call (read-only, so far below CODER_MAX_TURNS):
# PLAN_MAX_TURNS=30
#
# Wall-clock per plan call. Added to the revision-loop budget (x MAX_REVISIONS)
# and to test-author, but only for stages that actually have a plan model:
# STAGE_TIMEOUT_MS_PLAN=600000
# ---------------------------------------------------------------------------

# Optional: State directory (default: .state)
# STATE_DIR=.state

# Optional: Max agent turns for the coder / test-author stages (defaults: 80 / 50)
# CODER_MAX_TURNS=80
# TEST_AUTHOR_MAX_TURNS=50

# Optional: turn budget for EACH reviewer axis, not the six-axis fan-out as a
# whole (default: 50). Every axis explores the worktree with Bash/Grep before
# reporting, and safety-correctness is consistently the heaviest — raise this if
# a run fails with "Reached maximum number of turns". Note the cost multiplies
# by six, so weigh it against MAX_COST_USD_PER_WI.
# REVIEWER_MAX_TURNS=50

# Plan 6 - safety rails ----------------------------------------------------

# Maximum cumulative cost (USD) per work item before the pipeline is hard-killed
# (required; no default - operator must consciously set this).
MAX_COST_USD_PER_WI=5.00

# Per-stage wall-clock timeouts (milliseconds). All optional; defaults shown.
# A stage that exceeds its timeout fails terminally and posts a timeout comment.
# The coder and reviewer run nested inside the top-level revision-loop stage:
# CODER/REVIEWER values are per-iteration budgets that size the loop's default —
# STAGE_TIMEOUT_MS_REVISION_LOOP defaults to MAX_REVISIONS × (CODER + REVIEWER)
# (3 × 45 min = 135 min with defaults) and can be pinned explicitly.
# STAGE_TIMEOUT_MS_ANALYZER=300000           # 5min
# STAGE_TIMEOUT_MS_WORKTREE_SETUP=60000      # 1min
# STAGE_TIMEOUT_MS_CODER=1800000             # 30min (per revision iteration)
# STAGE_TIMEOUT_MS_REVIEWER=900000           # 15min (per revision iteration)
# STAGE_TIMEOUT_MS_REVISION_LOOP=8100000     # 135min (derived when unset)
# STAGE_TIMEOUT_MS_TEST_AUTHOR=1200000       # 20min
# STAGE_TIMEOUT_MS_DRAFT_PR_CREATOR=600000   # 10min (push + the pr-message call + ADO)
# STAGE_TIMEOUT_MS_WORKTREE_TEARDOWN=60000   # 1min

# Plan 10 - verification gate ----------------------------------------------
# REQUIRED unless SKIP_BUILD_TEST=true: CONTINIA_API_TOKEN must be set -
# config validation fails fast without it otherwise.

# DemoPortal API token, forwarded into the spawned continia.exe process env.
CONTINIA_API_TOKEN=

# Optional. Pins the DemoPortal profile and overrides per-WI derivation.
# Normally left unset — env-provision derives the BC version from app.json.
CONTINIA_ENV_PROFILE_ID=
# Optional: localization of the derived profile (default: base). A blank value
# falls back to base. base, dk, nl, de, gb, us, ...
# CONTINIA_ENV_LOCALIZATION=base

# Optional: pin the AL app dirs to deps-install and deploy, comma-separated, in
# dependency order, relative to the per-WI worktree. LEAVE UNSET normally —
# build-and-test derives the set per work item from the files the run changed
# plus the apps owning the selected tests, expands it over app.json
# dependencies, and orders it dependency-first. A static list cannot be right
# in a repo where one WI touches base-application and the next touches export.
# CONTINIA_APP_PATHS=

# Optional: where to scan for test codeunits. Unset = every app in the repo.
# Discovery is filesystem-only and cheap; TEST_SELECTION bounds what actually
# runs, so there is rarely a reason to narrow this.
# CONTINIA_TEST_APP_PATHS=

# Optional: path to continia.exe. Relative paths resolve against the per-WI
# worktree; set an absolute path if the target repo doesn't vendor the CLI.
# CONTINIA_CLI_PATH=.tools/continia.exe

# Optional: coder fix attempts when deploy/tests are red before hard failure.
# MAX_TEST_FIX_ATTEMPTS=2

# Plan 14 - fix-findings + in-loop verification -----------------------------

# Model for the fix-findings step (revision rounds 2+). Falls back to CLAUDE_MODEL.
# This is the knob for spending more on fixing than on first-draft writing.
# CLAUDE_MODEL_FIX_FINDINGS=

# Turn budget for the fix-findings step. Falls back to CODER_MAX_TURNS.
# FIX_FINDINGS_MAX_TURNS=

# Wall-clock budget per fix-findings call. Falls back to STAGE_TIMEOUT_MS_CODER.
# STAGE_TIMEOUT_MS_FIX_FINDINGS=

# test-fixer calls the in-loop verification gate may make per revision round.
# Deliberately smaller than MAX_TEST_FIX_ATTEMPTS: this budget is paid once per
# revision round, on top of the final build-and-test gate's own budget.
# MAX_INLOOP_FIX_ATTEMPTS=1

# Which discovered test codeunits a verification round runs (default: related).
# Codeunits run STRICTLY SEQUENTIALLY against one environment, so running a
# whole AL suite is hours of wall clock and a guaranteed stage timeout.
#   changed - only test codeunits declared in files this run touched
#   related - those, plus tests referencing an AL object declared in a changed
#             non-test file (heuristic: object-name references, not a dep graph)
#   all     - the full discovered suite
# TEST_SELECTION=related

# Hard ceiling on test codeunits per round; 0 = unlimited (default: 25).
# Guards the case where a changed base object is referenced by most of the
# suite. Dropped codeunits are logged as a WARNING - a capped green round does
# NOT mean everything passed.
# CONTINIA_MAX_TEST_CODEUNITS=25

# Optional timeouts: one deterministic deploy+test pass, and the whole stage.
# STAGE_TIMEOUT_MS_ENV_PROVISION=300000      # 5min
# STAGE_TIMEOUT_MS_VERIFY_PASS=900000        # 15min (per deploy+test pass; only
#   sizes the STAGE_TIMEOUT_MS_BUILD_AND_TEST derived default below - it does
#   not gate anything else directly)
# STAGE_TIMEOUT_MS_BUILD_AND_TEST=6300000    # 105min (derived when unset:
#   (MAX_TEST_FIX_ATTEMPTS+1) x VERIFY_PASS + MAX_TEST_FIX_ATTEMPTS x CODER)

# Optional: --timeout (seconds) for each `continia test run` (default: 600).
# CONTINIA_TEST_TIMEOUT_S=600

# Optional: skip env-provision + build-and-test entirely (harness smoke tests).
# When true, CONTINIA_API_TOKEN above becomes optional too.
# SKIP_BUILD_TEST=false

# Optional: dir containing an orchestrator-owned skills/ tree to symlink into
# each worktree's .claude/ (the Docker image sets /app/.claude). Unset locally
# unless you want this repo's .claude/skills available to the agents.
# SKILLS_SOURCE_DIR=/app/.claude

# Optional: absolute path to the Claude Code CLI, forwarded to the Agent SDK as
# pathToClaudeCodeExecutable. Unset, the SDK probes for its own bundled native
# binary; under Bun on a glibc image that probe picks the *-musl package and
# fails with "Claude Code native binary not found". The Docker image sets this.
# CLAUDE_CODE_EXECUTABLE_PATH=/home/claude/.local/bin/claude

# Read by the spawned Continia CLI itself (not validated by this service):
# CONTINIA_ALC_PATH=/opt/al/bin/linux/alc
# CONTINIA_AUTO_INSTALL_ALC=0

# Optional: append-only JSONL spend log — one record per finished work item
# (workItemId, outcome, costUsd, prId, prUrl, and the per-step breakdown: usd,
# calls, model and tokens for each of analyzer / coder-plan / coder /
# reviewer:<axis> / test-author-plan / test-author / test-fixer).
# Default: <STATE_DIR>/cost-ledger.jsonl. Dry runs never write to it.
# COST_LOG_PATH=.state/cost-ledger.jsonl

# Optional: directory holding one log file per work item, `WI<id>.log`. Each
# file collects every line the pipeline logged for that WI — across cycles, so a
# resumed run keeps the earlier cycle that banked most of the spend — and closes
# with a per-step cost table (usd, calls, model, tokens, turns). Dry runs never
# write to it. In Docker, bind-mount this so the files are readable on the host.
# Default: logs
# LOG_DIR=logs

# Optional: Only act on WIs assigned to these people (comma-separated, default: all)
# ASSIGNED_TO_FILTER=Alice Smith,Bob Jones
