# Azure DevOps Configuration (required)
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_ORG=your-org-name
AZURE_DEVOPS_PROJECT=your-project-name

# ADO Git repository name (required)
ADO_REPOSITORY_NAME=continia-banking

# Target repository where DevopsCoder writes branches/PRs (required)
TARGET_REPO_PATH=/repos/continia-banking

# Base directory for per-work-item git worktrees (required)
WORKTREE_BASE=/repos/.worktrees

# Optional: Tag that triggers the implement pipeline (default: agent implement)
# TRIGGER_TAG=agent implement

# Optional: Tag set by the service when revision loop is exhausted (default: agent-blocked)
# BLOCKED_TAG=agent-blocked

# Optional: Tag set by the service when analyzer rejects a work item (default: need-input)
# NEED_INPUT_TAG=need-input

# Optional: Polling interval in minutes (default: 5)
# POLL_INTERVAL_MINUTES=5

# Optional: Max concurrent pipelines (default: 1)
# CONCURRENCY=1

# Optional: Max revision loop iterations before escalating (default: 3)
# MAX_REVISIONS=3

# Optional: Max analyzer reject cycles per WI before need-input lockout (default: 3)
# MAX_REJECT_CYCLES=3

# Optional: Claude model to use (default: claude-opus-4-7)
# CLAUDE_MODEL=claude-opus-4-7

# Optional: State directory (default: .state)
# STATE_DIR=.state

# Optional: Max agent turns for the coder / test-author stages (defaults: 80 / 50)
# CODER_MAX_TURNS=80
# TEST_AUTHOR_MAX_TURNS=50

# Plan 6 - safety rails ----------------------------------------------------

# Maximum cumulative cost (USD) per work item before the pipeline is hard-killed
# (required; no default - operator must consciously set this).
MAX_COST_USD_PER_WI=5.00

# Per-stage wall-clock timeouts (milliseconds). All optional; defaults shown.
# A stage that exceeds its timeout fails terminally and posts a timeout comment.
# The coder and reviewer run nested inside the top-level revision-loop stage:
# CODER/REVIEWER values are per-iteration budgets that size the loop's default —
# STAGE_TIMEOUT_MS_REVISION_LOOP defaults to MAX_REVISIONS × (CODER + REVIEWER)
# (3 × 45 min = 135 min with defaults) and can be pinned explicitly.
# STAGE_TIMEOUT_MS_ANALYZER=300000           # 5min
# STAGE_TIMEOUT_MS_WORKTREE_SETUP=60000      # 1min
# STAGE_TIMEOUT_MS_CODER=1800000             # 30min (per revision iteration)
# STAGE_TIMEOUT_MS_REVIEWER=900000           # 15min (per revision iteration)
# STAGE_TIMEOUT_MS_REVISION_LOOP=8100000     # 135min (derived when unset)
# STAGE_TIMEOUT_MS_TEST_AUTHOR=1200000       # 20min
# STAGE_TIMEOUT_MS_DRAFT_PR_CREATOR=120000   # 2min
# STAGE_TIMEOUT_MS_WORKTREE_TEARDOWN=60000   # 1min

# Plan 10 - verification gate ----------------------------------------------
# REQUIRED unless SKIP_BUILD_TEST=true: the three CONTINIA_* vars below must
# be set - config validation fails fast without them otherwise.

# DemoPortal profile used to create the per-WI BC environment
# (see `continia env profiles versions` / `continia env profiles list`).
CONTINIA_ENV_PROFILE_ID=

# DemoPortal API token, forwarded into the spawned continia.exe process env.
CONTINIA_API_TOKEN=

# AL app directories to deps-install and deploy, comma-separated, in
# dependency order, relative to the per-WI worktree.
CONTINIA_APP_PATHS=Core/Cloud,Banking/Cloud

# Optional: where to scan for test codeunits (defaults to CONTINIA_APP_PATHS).
# CONTINIA_TEST_APP_PATHS=Banking/Test

# Optional: path to continia.exe. Relative paths resolve against the per-WI
# worktree; set an absolute path if the target repo doesn't vendor the CLI.
# CONTINIA_CLI_PATH=.tools/continia.exe

# Optional: coder fix attempts when deploy/tests are red before hard failure.
# MAX_TEST_FIX_ATTEMPTS=2

# Optional timeouts: one deterministic deploy+test pass, and the whole stage.
# STAGE_TIMEOUT_MS_ENV_PROVISION=300000      # 5min
# STAGE_TIMEOUT_MS_VERIFY_PASS=900000        # 15min (per deploy+test pass; only
#   sizes the STAGE_TIMEOUT_MS_BUILD_AND_TEST derived default below - it does
#   not gate anything else directly)
# STAGE_TIMEOUT_MS_BUILD_AND_TEST=6300000    # 105min (derived when unset:
#   (MAX_TEST_FIX_ATTEMPTS+1) x VERIFY_PASS + MAX_TEST_FIX_ATTEMPTS x CODER)

# Optional: --timeout (seconds) for each `continia test run` (default: 600).
# CONTINIA_TEST_TIMEOUT_S=600

# Optional: skip env-provision + build-and-test entirely (harness smoke tests).
# When true, the three CONTINIA_* vars above become optional.
# SKIP_BUILD_TEST=false

# Optional: dir containing an orchestrator-owned skills/ tree to symlink into
# each worktree's .claude/ (the Docker image sets /app/.claude). Unset locally
# unless you want this repo's .claude/skills available to the agents.
# SKILLS_SOURCE_DIR=/app/.claude

# Read by the spawned Continia CLI itself (not validated by this service):
# CONTINIA_ALC_PATH=/opt/al/bin/linux/alc
# CONTINIA_AUTO_INSTALL_ALC=0

# Optional: Only act on WIs assigned to these people (comma-separated, default: all)
# ASSIGNED_TO_FILTER=Alice Smith,Bob Jones
